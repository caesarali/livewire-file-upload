{
    "name": "caesarali/livewire-file-upload",
    "description": "A FilePond-powered Livewire upload component for standard Laravel form submissions.",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "illuminate/contracts": "^11.0|^12.0|^13.0",
        "livewire/livewire": "^4.1.3",
        "spatie/livewire-filepond": "^1.7"
    },
    "require-dev": {
        "laravel/pint": "^1.27",
        "orchestra/testbench": "^9.0|^10.9|^11.0",
        "pestphp/pest": "^3.8|^4.0",
        "pestphp/pest-plugin-laravel": "^3.2|^4.0"
    },
    "autoload": {
        "psr-4": {
            "Caesarali\\LivewireFileUpload\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Caesarali\\LivewireFileUpload\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "format": "vendor/bin/pint",
        "test": "vendor/bin/pest"
    },
    "extra": {
        "laravel": {
            "providers": [
                "Caesarali\\LivewireFileUpload\\LivewireFileUploadServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
